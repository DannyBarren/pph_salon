# ─────────────────────────────────────────────────────────────────────────────
# FRONTEND production environment (Next.js on Vercel).
# Add these in Vercel → Project → Settings → Environment Variables.
# Only NEXT_PUBLIC_* vars are exposed to the browser (never put secrets here).
# ─────────────────────────────────────────────────────────────────────────────

# Base URL of the deployed FastAPI backend. The app appends /api/v1 if omitted.
NEXT_PUBLIC_API_BASE_URL=https://your-backend.up.railway.app

# Lock the app down: require real JWT login, hide the demo account switcher,
# route all data through the backend, and disable localStorage mock persistence.
NEXT_PUBLIC_DEMO_MODE=false

# Team Dashboard feature flag (default on). Set false to use the legacy view.
NEXT_PUBLIC_FEATURE_TEAM_DASHBOARD=true

# Optional: browser error reporting (Sentry). Leave blank to disable.
NEXT_PUBLIC_SENTRY_DSN=
