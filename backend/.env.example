# Copy to `.env` and adjust for local development.
ENVIRONMENT=development

# PostgreSQL connection (matches docker-compose defaults).
DATABASE_URL=postgresql+psycopg2://pph:pph@localhost:5432/pph

# CORS — the Next.js frontend origin(s).
CORS_ORIGINS=["http://localhost:3000"]

# ── Auth / JWT ───────────────────────────────────────────────────────────
# CHANGE THIS in any real environment.
SECRET_KEY=dev-insecure-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# ── Demo mode ────────────────────────────────────────────────────────────
# true  → all auth bypassed; an admin user is injected (no login needed).
# false → enforce real JWT + role checks.
DEMO_MODE=true
