# Copy to `.env` and adjust for local development.
ENVIRONMENT=development
LOG_LEVEL=INFO

# PostgreSQL connection (matches docker-compose defaults).
DATABASE_URL=postgresql+psycopg2://pph:pph@localhost:5432/pph

# CORS — the Next.js frontend origin(s). JSON list or comma-separated.
CORS_ORIGINS=http://localhost:3000
# Trusted Host allow-list (use real hosts in prod; * disables the check).
ALLOWED_HOSTS=*

# ── Auth / JWT ───────────────────────────────────────────────────────────
# CHANGE THIS in any real environment (>=32 chars in production).
SECRET_KEY=dev-insecure-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
MIN_PASSWORD_LENGTH=8

# ── Rate limiting ────────────────────────────────────────────────────────
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=200/minute
RATE_LIMIT_LOGIN=10/minute
RATE_LIMIT_IMPORT=20/minute

# ── Docs ─────────────────────────────────────────────────────────────────
ENABLE_DOCS=true

# ── Email / SMS notification stubs (optional) ────────────────────────────
# SENDGRID_API_KEY=
# EMAIL_FROM=no-reply@pph.local
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
REQUIRE_EMAIL_VERIFICATION=false

# ── Observability (optional) ─────────────────────────────────────────────
# SENTRY_DSN=

# ── First-run bootstrap (optional) ───────────────────────────────────────
# One-time token enabling POST /auth/bootstrap / the /setup page to create the
# first owner while the users table is empty. Leave unset to disable.
# BOOTSTRAP_TOKEN=

# ── Demo mode ────────────────────────────────────────────────────────────
# true  → all auth bypassed; an admin user is injected (no login needed).
# false → enforce real JWT + role checks. FORCED to false when ENVIRONMENT=production.
DEMO_MODE=true
