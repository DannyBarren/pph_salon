# ─────────────────────────────────────────────────────────────────────────────
# BACKEND production environment (FastAPI on Railway / Render / Fly / Docker).
# Copy the values into your host's secret manager — DO NOT commit a real .env.
# ─────────────────────────────────────────────────────────────────────────────

ENVIRONMENT=production
LOG_LEVEL=INFO

# Managed Postgres connection string from your provider (Neon/Supabase/Railway).
# NOTE the SQLAlchemy driver prefix `postgresql+psycopg2://`.
DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@HOST:5432/DBNAME

# Only your deployed frontend origin(s). Comma-separated or JSON list.
CORS_ORIGINS=https://your-app.vercel.app
# Your backend's public hostname(s) — protects against Host header attacks.
ALLOWED_HOSTS=your-backend.up.railway.app

# ── Auth / JWT ───────────────────────────────────────────────────────────
# REQUIRED: a strong random secret (>=32 chars). Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_STRING_AT_LEAST_32_CHARS
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
MIN_PASSWORD_LENGTH=10

# ── Rate limiting ────────────────────────────────────────────────────────
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=200/minute
RATE_LIMIT_LOGIN=10/minute
RATE_LIMIT_IMPORT=20/minute

# ── Docs ─────────────────────────────────────────────────────────────────
# Keep API docs private in production (set true only if you gate them).
ENABLE_DOCS=false

# ── Email / SMS (optional but recommended for user invites) ──────────────
SENDGRID_API_KEY=
EMAIL_FROM=no-reply@yourdomain.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
REQUIRE_EMAIL_VERIFICATION=false

# ── Observability (optional) ─────────────────────────────────────────────
SENTRY_DSN=

# ── Demo mode — MUST be false in production (also force-disabled in code) ─
DEMO_MODE=false

# Gunicorn worker count (tune to CPU). Read by entrypoint.sh.
WEB_CONCURRENCY=4
